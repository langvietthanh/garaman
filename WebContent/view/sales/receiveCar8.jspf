<%-- Ham dung chung cho module Nhan xe vao sua (include tinh, khong phai lop trong class diagram). --%>
<%@ page pageEncoding="UTF-8" %>
<%@ page import="java.util.*, java.text.*, model.*" %>
<%!
    /** Dinh dang tien theo chuan Viet Nam: 1290000 -> "1.290.000" (dau cham ngan cach hang nghin; don vi (VNĐ) ghi o ten cot). */
    String money(float v) {
        NumberFormat vn = NumberFormat.getNumberInstance(Locale.forLanguageTag("vi-VN"));
        return vn.format(Math.round(v));
    }

    String code(String prefix, int id) {
        return prefix + String.format("%02d", id);
    }

    String esc(String s) {
        if (s == null) return "";
        return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;");
    }

    /** Cot "Mức giảm" cua 1 khuyen mai, vd "10% (tối đa 50.000đ)", "20.000đ". */
    String discountValue(Discount8 k) {
        if ("Phần trăm".equals(k.getDiscountType())) {
            String s = Math.round(k.getDiscountValue()) + "%";
            if (k.getMaxDiscountAmount() > 0) s += " (tối đa " + money(k.getMaxDiscountAmount()) + "đ)";
            return s;
        }
        return money(k.getDiscountValue()) + "đ";
    }

    /** Cot "Điều kiện áp dụng" cua 1 khuyen mai: muc toi thieu + cac DiscountCondition8 (HTML da escape). */
    String discountCondition(Discount8 k) {
        List<String> cs = new ArrayList<String>();
        boolean hasTotalCond = false;
        if (k.getDiscountConditions() != null) {
            for (DiscountCondition8 c : k.getDiscountConditions()) {
                if ("Tổng tiền".equals(c.getConditionType())) hasTotalCond = true;
                if (c.getDescription() != null) cs.add(esc(c.getDescription()));
            }
        }
        // muc toi thieu chi hien khi chua co dieu kien "Tổng tiền" mo ta dieu nay
        if (k.getMinApplicableAmount() > 0 && !hasTotalCond) cs.add(0, "Thành tiền từ " + money(k.getMinApplicableAmount()) + "đ");
        return cs.isEmpty() ? "Không điều kiện" : String.join("; ", cs);
    }

    /** 3 o Khuyến mãi | Mức giảm | Điều kiện áp dụng cua 1 khuyen mai (k = null: "Không áp dụng"). */
    String discountCells(Discount8 k) {
        if (k == null) return "<td>Không áp dụng</td><td></td><td class=\"wrap\"></td>";
        return "<td>" + esc(k.getDiscountName()) + "</td><td class=\"nowrap\">" + discountValue(k)
                + "</td><td class=\"wrap\">" + discountCondition(k) + "</td>";
    }

    /** Danh sach giam gia cua 1 dich vu/phu tung (co the null) -> mang cho calculatePrice(). */
    Discount8[] toArray(List<Discount8> ks) {
        return ks == null ? new Discount8[0] : ks.toArray(new Discount8[0]);
    }
%>
